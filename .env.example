# Skopiuj do .env.local i uzupełnij. Te same wartości ustaw w panelu Vercela.

# --- Sanity ---
# Z sanity.io/manage → Project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sekret webhooka rewalidującego. Wymyśl długi losowy ciąg i wpisz go
# także w sanity.io/manage → API → Webhooks → Secret.
SANITY_REVALIDATE_SECRET=

# Token z uprawnieniem Editor — potrzebny tylko do skryptu `npm run seed`.
# Nie ustawiaj go na Vercelu; strona publiczna czyta dane bez tokenu.
SANITY_WRITE_TOKEN=

# --- Formularz wyceny (Resend) ---
# resend.com → API Keys
RESEND_API_KEY=
# Adres nadawcy z domeny zweryfikowanej w Resend, np. "B. Coffee <strona@bcoffee.pl>".
# Adres odbiorcy ustawia się w Sanity (Ustawienia strony → E-mail na zapytania).
INQUIRY_FROM_EMAIL=
